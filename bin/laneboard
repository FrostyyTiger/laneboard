#!/usr/bin/env node
// laneboard — CLI over the local API. Used by humans, and over ssh by the planning session.
//
//   laneboard ls                       table of every session
//   laneboard peek <name> [-n 40]      the last N lines of a session's pane
//   laneboard send <name> "text"       type text + Enter into a session
//   laneboard keys <name> Enter [C-c]  send tmux key names
//   laneboard events [-n 50] [--session s] [--type t]
//   laneboard cost [--today]
//   laneboard morning [--window w]     what needs you, what finished, what it cost
//   laneboard spawn <name> <dir> ["prompt"] [--model m]
//   laneboard kill <name>              asks y/N on a TTY
//   laneboard restart <name>           kill + --resume the same sessionId
//   laneboard dirs                     git repos you can spawn into
//   laneboard launch <lane> --plan docs/plans/<lane>.md [--repo r] [--branch b]
//                  [--model m] [--permission-mode p] [--no-wait]
//   laneboard retire <lane> [--force [--confirm <lane>]]
//   laneboard fleet keygen [--out <file>] [--force]   offline: write the hub key
//   laneboard fleet pubkey [--key <file>] [--pem]     offline: its public key for fleet.hubKeys
//   laneboard audit [-n 50] [--since 1h] [--file f] [--json]   offline: tail the audit log
//   laneboard audit verify [--file f]                 offline: check the hash chain
//   laneboard pause <name|--all> [--reason r]          offline: write a pause sentinel
//   laneboard resume <name|--all>                      offline: lift an operator pause
//   laneboard paused [--json]                          offline: list the pause sentinels
//   laneboard run start|round|score|needs|ack|artifact|stop|cost [--run <id>] [flags] [--file f | --post]
//                                                      offline: append one run-protocol line
//     start    [--goal g] [--plan p] [--branch b] [--host h] [--deadline iso] [--max-rounds N] [--window-pct P]
//              (--rounds N on start is --max-rounds' old name; on stop it is the count done)
//     round    --n N [--role r] [--task t]             prints `export LANEBOARD_RUN=<run>/<n>` for eval
//     round    --n N --end [--outcome o] [--commit sha] [--open N] [--usd x]
//     score    --name m --value x [--better higher|lower] [--n N] [--max x]
//     needs    [--kind decision|wait] [--text t] [--link url] [--n N]
//     ack      [<run>] <ref> [--by b]                  closes a need: ref = its place (0 = first) or its ts; a closed one: nothing sent
//     artifact --url u [--kind pr|link] [--title t] [--state open|merged|closed]
//     stop     [--reason done|deadline|rounds|…] [--rounds N] [--usd x]
//     cost     --usd x [--n N]                         the run's cost is the sum of these (else of the rounds' --usd)
//     The line goes to --file, else $LANEBOARD_RUN_FILE, else ./.laneboard/run.jsonl;
//     --post sends it to POST /api/runs/events instead. --run defaults to the run
//     part of $LANEBOARD_RUN (start says so on stderr). --run/--file/--post may
//     also come before <sub>.
//     A bad argument prints one line and exits 2. See docs/runs.md.
//   laneboard feed tailscale|proxmox|docker [--source s] [--every N] [--stdout | --out <file> | --push <url>]
//                                                      offline: read one source once, write one feed
//     proxmox  --url https://<host>:8006 --token-id user@realm!name [--secret-file f] [--ca pem] [--node n]
//     docker   [--socket path]  (GET /containers/json only; default /var/run/docker.sock)
//     every kind: [--timeout <s>]
//     --stdout (the default) prints the feed, for an ssh forced command on the board;
//     --out writes it atomically (temp + rename, mode 0600); --push POSTs it to <url>/api/map/feeds.
//     The secret comes from --secret-file or $LANEBOARD_PVE_SECRET, never a flag.
//     `none`, an unknown kind or a bad argument prints one line and exits 2;
//     a source that cannot be read exits 1. See docs/map.md "Pushing a feed".
//
// Every string that came from a server (or an audit file) passes cleanTerm()
// before it is printed, so a session name cannot carry terminal escapes
// (OSC 52 clipboard writes, cursor moves) to the user's terminal.
//
// Exit codes: 0 ok, 1 error, 2 usage.
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import process from 'node:process';
import readline from 'node:readline';

const BASE = process.env.LANEBOARD_URL || 'http://127.0.0.1:7777';

// `laneboard ls | head` closes the pipe early; that is not an error worth a stack
// trace. Node's default is to throw EPIPE from the write.
for (const stream of [process.stdout, process.stderr]) {
  stream.on('error', (err) => {
    if (err?.code === 'EPIPE') process.exit(0);
    throw err;
  });
}

const argv = process.argv.slice(2);
const cmd = argv.shift();

// ---------------------------------------------------------------- arg parsing

function takeFlag(name, fallback = null) {
  const i = argv.indexOf(name);
  if (i < 0) return fallback;
  const v = argv[i + 1];
  argv.splice(i, 2);
  return v ?? fallback;
}
function takeBool(name) {
  const i = argv.indexOf(name);
  if (i < 0) return false;
  argv.splice(i, 1);
  return true;
}

// ---------------------------------------------------------------- terminal safety

// C0 except tab (so ESC, BEL, CR, LF, BS), DEL, and C1 (incl. the 8-bit CSI/OSC introducers).
// eslint-disable-next-line no-control-regex
const TERM_UNSAFE = /[\u0000-\u0008\u000a-\u001f\u007f-\u009f]/g;

/** Strip characters a terminal would interpret from a string we did not write ourselves. */
function cleanTerm(s) {
  return String(s ?? '').replace(TERM_UNSAFE, '');
}

/** cleanTerm every string (keys included) of parsed JSON. */
function cleanDeep(v) {
  if (typeof v === 'string') return cleanTerm(v);
  if (Array.isArray(v)) return v.map(cleanDeep);
  if (v && typeof v === 'object') {
    const out = {};
    for (const [k, x] of Object.entries(v)) {
      const ck = cleanTerm(k);
      if (ck === '__proto__') continue;
      out[ck] = cleanDeep(x);
    }
    return out;
  }
  return v;
}

// ---------------------------------------------------------------- http

let answered = null;

/** `board: <url>` on stderr once the board answered, so stdout stays parseable
 *  (`laneboard ls | …`) and a reader sees which board the numbers came from. */
function boardLine() {
  if (answered) process.stderr.write(`board: ${cleanTerm(answered)}\n`);
}

async function api(path, { method = 'GET', body } = {}) {
  let res;
  try {
    res = await fetch(`${BASE}${path}`, {
      method,
      // `X-Laneboard: 1` is the server's CSRF barrier on every mutating route.
      headers: body ? { 'content-type': 'application/json', 'x-laneboard': '1' } : { 'x-laneboard': '1' },
      body: body ? JSON.stringify(body) : undefined,
    });
  } catch (err) {
    const e = new Error(`cannot reach the laneboard at ${BASE} (${err.message})`);
    e.unreachable = true;
    throw e;
  }
  // The board that answered (after any redirect), for `board: <url>` (boardLine).
  answered = res.redirected ? new URL(res.url).origin : BASE;
  const text = await res.text();
  let data;
  try { data = text ? JSON.parse(text) : {}; } catch { data = { raw: text }; }
  // Server text is untrusted for the terminal: clean every string once, here.
  data = cleanDeep(data);
  if (!res.ok) die(data.error || `HTTP ${res.status}`);
  return data;
}

function die(msg, code = 1) {
  // Keep our own line breaks, clean everything else (messages may quote server or file text).
  process.stderr.write(`laneboard: ${String(msg).split('\n').map(cleanTerm).join('\n')}\n`);
  process.exit(code);
}

// ---------------------------------------------------------------- formatting

const C = process.stdout.isTTY
  ? { dim: '\u001b[2m', red: '\u001b[31m', amber: '\u001b[33m', blue: '\u001b[34m', green: '\u001b[32m', grey: '\u001b[90m', off: '\u001b[0m', bold: '\u001b[1m' }
  : { dim: '', red: '', amber: '', blue: '', green: '', grey: '', off: '', bold: '' };

const STATE_COLOUR = {
  waiting_permission: C.red,
  waiting_question: C.amber,
  working: C.blue,
  done: C.green,
  idle: C.grey,
  shell: C.grey,
  dead: C.dim,
};

function ago(ts) {
  if (!ts) return '-';
  const s = Math.max(0, Math.round((Date.now() - ts) / 1000));
  if (s < 60) return `${s}s`;
  if (s < 3600) return `${Math.round(s / 60)}m`;
  if (s < 86400) return `${Math.round(s / 3600)}h`;
  return `${Math.round(s / 86400)}d`;
}

const money = (v) => (v == null ? '-' : `$${v.toFixed(2)}`);

/** `2026-10-21 18:00` in the terminal's local time: the ISO order, no seconds. */
function isoLocal(ts) {
  const d = new Date(ts);
  if (Number.isNaN(d.getTime())) return '-';
  const p = (n) => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
}

const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`;
const clip = (v, n) => { const t = String(v ?? '').replace(/\s+/g, ' '); return t.length > n ? `${t.slice(0, n - 1)}…` : t; };

/** Width ignoring ANSI, so coloured columns still line up. */
const width = (s) => String(s).replace(/\u001b\[[0-9;]*m/g, '').length;

function table(rows, headers) {
  if (!rows.length) return '(none)';
  const cols = headers.length;
  const w = headers.map((h, i) => Math.max(width(h), ...rows.map((r) => width(r[i] ?? ''))));
  const line = (cells, colour = '') =>
    cells.map((c, i) => `${colour}${c}${colour ? C.off : ''}${' '.repeat(w[i] - width(c))}`).join('  ').trimEnd();
  return [line(headers, C.dim), ...rows.map((r) => line(r.slice(0, cols)))].join('\n');
}

// ---------------------------------------------------------------- commands

async function cmdLs() {
  const { sessions, attention } = await api('/api/state');
  boardLine();
  const order = { waiting_permission: 0, waiting_question: 1, working: 2, done: 3, idle: 4, shell: 5, dead: 6 };
  sessions.sort((a, b) => (order[a.state] ?? 9) - (order[b.state] ?? 9) || a.name.localeCompare(b.name));
  const rows = sessions.map((s) => [
    s.name,
    `${STATE_COLOUR[s.state] || ''}${s.state}${C.off}`,
    ago(s.stateSince),
    (s.dir || '').replace(/^\/home\/[^/]+/, '~'),
    s.branch || '-',
    s.claude?.model || (s.paneCmd === 'claude' ? '?' : s.paneCmd || '-'),
    s.context?.usedPct != null ? `${s.context.usedPct}%` : '-',
    money(s.cost?.usd),
  ]);
  process.stdout.write(`${table(rows, ['NAME', 'STATE', 'SINCE', 'DIR', 'BRANCH', 'MODEL', 'CTX', 'COST'])}\n`);
  if (attention.length) {
    process.stdout.write(`\n${C.bold}Needs you:${C.off} ${attention.map((a) => `${a.name} (${a.state}, ${ago(a.since)})`).join(', ')}\n`);
  }
}

async function cmdPeek() {
  const name = argv.shift();
  if (!name) die('usage: laneboard peek <name> [-n 40]', 2);
  const n = Number(takeFlag('-n', '40'));
  const data = await api(`/api/sessions/${encodeURIComponent(name)}/preview?n=${n}`);
  process.stdout.write(`${data.lines.join('\n')}\n`);
}

async function cmdSend() {
  const name = argv.shift();
  const text = argv.shift();
  if (!name || !text) die('usage: laneboard send <name> "text"', 2);
  await api(`/api/sessions/${encodeURIComponent(name)}/text`, { method: 'POST', body: { text, enter: true } });
  process.stdout.write(`sent to ${name}\n`);
}

async function cmdKeys() {
  const name = argv.shift();
  if (!name || !argv.length) die('usage: laneboard keys <name> Enter [C-c ...]', 2);
  await api(`/api/sessions/${encodeURIComponent(name)}/keys`, { method: 'POST', body: { keys: [...argv] } });
  process.stdout.write(`sent ${argv.join(' ')} to ${name}\n`);
}

async function cmdEvents() {
  const n = Number(takeFlag('-n', '50'));
  const session = takeFlag('--session');
  const type = takeFlag('--type');
  const qs = new URLSearchParams({ n: String(n) });
  if (session) qs.set('session', session);
  if (type) qs.set('type', type);
  const { events } = await api(`/api/events?${qs}`);
  const rows = events.map((e) => [
    new Date(e.ts).toLocaleTimeString('en-GB'),
    e.session_name || '-',
    e.type,
    e.subtype || '-',
    (e.payload?.tool_input || e.payload?.prompt || e.payload?.last_assistant_message || e.payload?.matcher || '')
      .toString().replace(/\s+/g, ' ').slice(0, 60),
  ]);
  process.stdout.write(`${table(rows, ['TIME', 'SESSION', 'EVENT', 'DETAIL', 'INFO'])}\n`);
}

async function cmdCost() {
  const todayOnly = takeBool('--today');
  const data = await api('/api/cost');
  const rows = data.sessions
    .filter((s) => (todayOnly ? s.usdToday : s.usd))
    .sort((a, b) => (todayOnly ? b.usdToday - a.usdToday : b.usd - a.usd))
    .map((s) => [
      s.name,
      money(s.usd),
      money(s.usdToday),
      s.statuslineUsd ? money(s.statuslineUsd) : '-',
      s.deltaPct == null ? '-' : `${s.deltaPct > 0 ? '+' : ''}${s.deltaPct}%`,
      s.pricedAsOpus ? 'opus-est' : '',
    ]);
  process.stdout.write(`${table(rows, ['NAME', 'ALL TIME', 'TODAY', 'CLAUDE', 'DELTA', ''])}\n`);
  process.stdout.write(
    `\n${C.dim}API-equivalent. On a subscription the 5 h / 7 d windows are the real limit.${C.off}\n` +
    `total ${money(data.totals.usd)}   today ${money(data.totals.usdToday)}\n`
  );
}

async function cmdSpawn() {
  const name = argv.shift();
  const dir = argv.shift();
  const prompt = argv.shift();
  const model = takeFlag('--model');
  if (!name || !dir) die('usage: laneboard spawn <name> <dir> ["prompt"] [--model m]', 2);
  // Only events from THIS spawn count — a previous run of the same session
  // name leaves its own spawn-prompt-delivered row behind.
  const since = Date.now();
  const r = await api('/api/sessions', { method: 'POST', body: { name, dir, prompt, model } });
  process.stdout.write(`spawned ${r.name} in ${r.dir}\n`);
  if (!r.promptPending) return;

  // The server delivers the prompt in the background once the pane is ready,
  // so poll rather than holding a request open across a possible restart.
  process.stdout.write('waiting for the prompt to be delivered');
  for (let i = 0; i < 90; i++) {
    await new Promise((res) => setTimeout(res, 1000));
    process.stdout.write('.');
    let events;
    try {
      ({ events } = await api(`/api/events?session=${encodeURIComponent(name)}&type=action&n=10`));
    } catch { continue; } // a restart mid-poll is not a failure
    const hit = events.find(
      (e) => e.ts >= since && (e.subtype === 'spawn-prompt-delivered' || e.subtype === 'spawn-prompt-failed')
    );
    if (!hit) continue;
    if (hit.subtype === 'spawn-prompt-delivered') {
      process.stdout.write(' delivered\n');
      return;
    }
    process.stdout.write(`\nprompt NOT delivered: ${hit.payload?.reason || 'unknown'}\n`);
    process.exitCode = 1;
    return;
  }
  process.stdout.write('\nstill waiting; check `laneboard events --session ' + name + '`\n');
}

async function confirm(question) {
  if (!process.stdin.isTTY) return true; // non-interactive callers opted in
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  const answer = await new Promise((res) => rl.question(`${question} [y/N] `, res));
  rl.close();
  return /^y(es)?$/i.test(answer.trim());
}

async function cmdKill() {
  const name = argv.shift();
  if (!name) die('usage: laneboard kill <name>', 2);
  if (!(await confirm(`Kill session ${JSON.stringify(name)}?`))) return process.stdout.write('cancelled\n');
  await api(`/api/sessions/${encodeURIComponent(name)}`, { method: 'DELETE' });
  process.stdout.write(`killed ${name}\n`);
}

async function cmdRestart() {
  const name = argv.shift();
  if (!name) die('usage: laneboard restart <name>', 2);
  if (!(await confirm(`Restart session ${JSON.stringify(name)} (resumes the same conversation)?`))) {
    return process.stdout.write('cancelled\n');
  }
  const r = await api(`/api/sessions/${encodeURIComponent(name)}/restart`, { method: 'POST' });
  process.stdout.write(`restarted ${name}${r.resumed ? ` (resumed ${r.resumed})` : ''}\n`);
}

/** The widest line `laneboard morning` prints, so it reads in an 100-column terminal. */
const MORNING_COLS = 100;

async function cmdMorning() {
  const window = takeFlag('--window', 'tonight');
  const m = await api(`/api/morning?window=${encodeURIComponent(window)}`);
  boardLine();
  process.stdout.write(`${C.bold}Morning — ${m.label}${C.off} ${C.dim}(since ${isoLocal(m.since)})${C.off}\n\n`);

  process.stdout.write(`${C.bold}Needs you${C.off} (${m.needsYou.length})\n`);
  if (!m.needsYou.length) process.stdout.write('  (nothing)\n');
  else {
    const rows = m.needsYou.map((n) => [
      `${STATE_COLOUR[n.state] || C.amber}${n.kind}${C.off}`,
      clip(n.name || '-', 24),
      clip(n.lane || '-', 20),
      ago(n.at),
      n.text || '',
    ]);
    process.stdout.write(`${fitLast(rows, ['WHAT', 'SESSION', 'LANE', 'AGE', 'DETAIL'])}\n`);
  }

  // A run that stopped in the window is news of the night, said with its
  // reason under Finished; the runs still going stay under Runs.
  const runs = Array.isArray(m.runs) ? m.runs : [];
  const stopped = runs.filter((r) => r.state === 'stopped' && (r.stoppedAt == null || r.stoppedAt >= m.since));
  const going = runs.filter((r) => !stopped.includes(r));
  const lanes = Array.isArray(m.finished) ? m.finished : [];
  const counts = [stopped.length ? `${plural(stopped.length, 'run')} stopped` : '', `${plural(lanes.length, 'lane')} active`];
  process.stdout.write(`\n${C.bold}Finished${C.off} (${counts.filter(Boolean).join(', ')})\n`);
  for (const r of stopped) process.stdout.write(`  ${morningRunLine(r)}\n`);
  if (!lanes.length) {
    if (!stopped.length) process.stdout.write('  (nothing moved)\n');
  } else {
    const rows = lanes.map((f) => [
      clip(f.lane, 24),
      f.progress?.n != null ? `${f.progress.n}/${f.progress.m}` : '-',
      clip(f.branch || '-', 28),
      f.isMain ? '-' : f.merged === true ? `${C.green}merged${C.off}` : f.merged === false ? `${C.amber}unmerged${C.off}` : '?',
      f.lastCommitAt ? ago(f.lastCommitAt) : '-',
      f.doneMarkers.length ? `${C.green}${f.doneMarkers.length} done${C.off}` : '',
      f.sessions.length ? plural(f.sessions.length, 'session') : '(idle)',
    ]);
    process.stdout.write(`${table(rows, ['LANE', 'STAGE', 'BRANCH', 'MERGED', 'COMMIT', 'DONE', 'SESSIONS'])}\n`);
  }

  if (going.length) {
    process.stdout.write(`\n${C.bold}Runs${C.off} (${going.length})\n`);
    for (const r of going) process.stdout.write(`  ${morningRunLine(r)}\n`);
  }

  process.stdout.write(`\n${C.bold}What it cost${C.off} ${C.dim}(API-equivalent)${C.off}\n`);
  const rows = m.cost.lanes
    .filter((l) => l.usd > 0.0005)
    .map((l) => [clip(l.lane || '(no lane)', 24), money(l.usd), compact(l.tokens), plural((l.sessions || []).length, 'session')]);
  process.stdout.write(`${table(rows, ['LANE', 'SPEND', 'TOKENS', 'SESSIONS'])}\n`);
  process.stdout.write(`total ${money(m.cost.totalUsd)}   ${compact(m.cost.totalTokens)} tokens\n`);
  const rl = m.rateLimits;
  if (rl) {
    const g = (x, label) => (x ? `${label} ${Math.round(x.usedPct)}% (resets ${new Date(x.resetsAt).toLocaleTimeString('en-GB', { hour12: false }).slice(0, 5)})` : '');
    process.stdout.write(`${C.dim}${g(rl.fiveHour, '5h')}   ${g(rl.sevenDay, '7d')}${C.off}\n`);
  }
}

/** A table whose last column is cut to what is left of MORNING_COLS. */
function fitLast(rows, headers) {
  const last = headers.length - 1;
  const rest = headers.slice(0, last).map((h, i) => Math.max(width(h), ...rows.map((r) => width(r[i] ?? ''))));
  const room = Math.max(10, MORNING_COLS - rest.reduce((a, w) => a + w + 2, 0));
  return table(rows.map((r) => [...r.slice(0, last), clip(r[last], room)]), headers);
}

/** One Morning run: id, rounds, each score start → end, stop reason, PRs, cost, goal. */
function morningRunLine(r) {
  const fmt = (v) => (typeof v === 'number' ? String(Math.round(v * 1000) / 1000) : '-');
  const scores = Object.entries(r.scores || {}).map(([name, s]) => {
    const moved = s.end - s.start;
    const good = moved === 0 || !s.better ? null : (moved > 0) === (s.better !== 'lower');
    const arrow = moved > 0 ? '↑' : moved < 0 ? '↓' : '=';
    const tint = good === true ? C.green : good === false ? C.amber : '';
    return `${name} ${fmt(s.start)}→${fmt(s.end)} ${tint}${arrow}${tint ? C.off : ''}`;
  });
  const prs = Array.isArray(r.prs) ? r.prs : [];
  const line = [
    `${C.bold}${clip(r.run, 32)}${C.off}`,
    plural(r.rounds, 'round'),
    ...scores,
    r.stop ? `stopped: ${clip(r.stop, 30)}` : r.state || '',
    prs.length ? plural(prs.length, 'PR') : '',
    r.usd == null ? '' : money(r.usd),
  ].filter(Boolean).join('  ');
  // The goal takes what is left of the line (2 for the indent, 2 for the gap).
  const room = MORNING_COLS - 4 - width(line);
  return r.goal && room >= 10 ? `${line}  ${C.dim}${clip(r.goal, room)}${C.off}` : line;
}

function compact(n) {
  const v = Number(n) || 0;
  if (v >= 1e9) return `${(v / 1e9).toFixed(1)}G`;
  if (v >= 1e6) return `${(v / 1e6).toFixed(1)}M`;
  if (v >= 1e3) return `${(v / 1e3).toFixed(1)}k`;
  return String(v);
}

async function cmdCredit() {
  const c = await api('/api/credit');
  boardLine();
  const rl = c.rateLimits || {};
  const g = (x, label) => (x
    ? `${label} ${String(Math.round(x.usedPct)).padStart(3)}%  resets ${new Date(x.resetsAt).toLocaleString('en-GB', { hour12: false }).slice(-8, -3)}`
    : `${label}   -`);
  process.stdout.write(`${C.bold}Credit${C.off}   ${g(rl.fiveHour, '5h')}   ${g(rl.sevenDay, '7d')}\n`);
  const s = c.sampler || {};
  process.stdout.write(`${C.dim}sampler: ${s.rows || 0} samples, last ${s.lastSampleAt ? ago(s.lastSampleAt) : 'never'}${C.off}\n\n`);
  const rows = c.lanes
    .filter((l) => (l.allTime ?? 0) > 0.005 || l.tonight > 0.005 || l.week > 0.005)
    .map((l) => [
      l.lane || '(no lane)',
      money(l.tonight), money(l.day), money(l.week), l.allTime == null ? '-' : money(l.allTime),
      compact(l.tokens.input), compact(l.tokens.output),
      compact(l.tokens.cacheRead), compact(l.tokens.cacheWrite),
    ]);
  process.stdout.write(`${table(rows, ['LANE', 'TONIGHT', '24H', '7D', 'ALL TIME', 'IN', 'OUT', 'CACHE RD', 'CACHE WR'])}\n`);
  process.stdout.write(
    `\ntotal  tonight ${money(c.totals.tonight)}   24h ${money(c.totals.day)}   ` +
    `7d ${money(c.totals.week)}   all time ${money(c.totals.allTime)}   ${C.dim}${c.label}${C.off}\n`
  );
}

/** Print a job's steps as they land, until it ends. Returns true on `done`. */
async function followJob(job, { timeoutMs = 45 * 60 * 1000 } = {}) {
  const seen = new Set();
  const until = Date.now() + timeoutMs;
  while (Date.now() < until) {
    let r;
    try { r = await api(`/api/jobs/${encodeURIComponent(job)}`); } catch { r = null; } // a restart mid-poll
    for (const st of r?.steps ?? []) {
      if (seen.has(st.id)) continue;
      seen.add(st.id);
      const mark = st.ok === false ? `${C.red}✗${C.off}` : `${C.green}✓${C.off}`;
      const detail = st.detail ? ` ${C.dim}${JSON.stringify(st.detail)}${C.off}` : '';
      process.stdout.write(`${mark} ${st.step}${detail}\n`);
      if (st.step === 'done') return true;
      if (st.step === 'failed' || st.step === 'interrupted') return false;
    }
    await new Promise((res) => setTimeout(res, 1500));
  }
  process.stdout.write(`still running; follow with: laneboard job ${job}\n`);
  return false;
}

async function cmdLaunch() {
  const lane = argv.shift();
  const body = {
    lane,
    plan: takeFlag('--plan'),
    repo: takeFlag('--repo'),
    branch: takeFlag('--branch'),
    model: takeFlag('--model'),
    permissionMode: takeFlag('--permission-mode'),
  };
  const noWait = takeBool('--no-wait');
  // Test only: see docs/status/laneboard-v3.md, Stage 3.
  if (takeBool('--local-branch')) body.localBranch = true;
  const promptOverride = takeFlag('--prompt');
  if (promptOverride) body.promptOverride = promptOverride;
  const fake = takeFlag('--fake-taken-slots');
  if (fake) body.fakeTakenSlots = fake.split(',').map(Number);
  if (!lane || !body.plan) die('usage: laneboard launch <lane> --plan docs/plans/<lane>.md [--repo <repo>] [--branch feat/<lane>] [--model opus] [--permission-mode auto]', 2);
  const r = await api('/api/lanes', { method: 'POST', body });
  process.stdout.write(`launching ${r.lane} on slot ${r.slot} (job ${r.job})\n`);
  if (noWait) return;
  if (!(await followJob(r.job))) process.exit(1);
}

async function cmdRetire() {
  const lane = argv.shift();
  const force = takeBool('--force');
  let confirmWith = takeFlag('--confirm');
  if (!lane) die('usage: laneboard retire <lane> [--force [--confirm <lane>]]', 2);
  if (force && !confirmWith) {
    if (!process.stdin.isTTY) die('--force without a TTY needs --confirm <lane>', 2);
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    confirmWith = await new Promise((res) => rl.question(
      `Force-retire ${lane}: stop its slot, DROP the slot's volumes, remove the worktree even if dirty. Type the lane id to confirm: `, res));
    rl.close();
    if (confirmWith.trim() !== lane) return process.stdout.write('cancelled\n');
    confirmWith = confirmWith.trim();
  }
  const body = force ? { force: true, confirm: confirmWith } : {};
  const r = await api(`/api/lanes/${encodeURIComponent(lane)}`, { method: 'DELETE', body });
  await followJob(r.job, { timeoutMs: 10000 });
  if (!r.ok) process.exit(1);
  process.stdout.write(`retired ${lane}; the branch ${r.branchKept} is kept (deleting branches is yours)\n`);
}

async function cmdJob() {
  const job = argv.shift();
  if (!job) die('usage: laneboard job <job-id>', 2);
  if (!(await followJob(job))) process.exit(1);
}

async function cmdDirs() {
  const { dirs } = await api('/api/dirs');
  process.stdout.write(`${table(dirs.map((d) => [d.name, d.branch || '-', d.dir]), ['NAME', 'BRANCH', 'PATH'])}\n`);
}

// ---------------------------------------------------------------- offline: fleet keys, audit log
// These never talk to a server and never import server/config.mjs. Private key
// material is never printed or logged; errors name files, not contents.

const fleetKeys = () => import('../server/fleet/keys-ed25519.mjs');
const fleetPaths = () => import('../server/fleet/paths.mjs');
const fleetAudit = () => import('../server/fleet/audit.mjs');

function fail(err) {
  die(err?.message || String(err));
}

async function cmdFleet() {
  const sub = argv.shift();
  if (sub === 'keygen') return fleetKeygen();
  if (sub === 'pubkey') return fleetPubkey();
  die('usage: laneboard fleet keygen [--out <file>] [--force] | laneboard fleet pubkey [--key <file>] [--pem]', 2);
}

async function fleetKeygen() {
  const out = takeFlag('--out');
  const force = takeBool('--force');
  if (argv.length) die(`unexpected argument: ${argv[0]}`, 2);
  const keys = await fleetKeys();
  let file;
  try {
    file = path.resolve(out ?? (await fleetPaths()).hubKeyFile());
  } catch (err) { return fail(err); }
  let exists = false;
  try { fs.lstatSync(file); exists = true; } catch (err) { if (err.code !== 'ENOENT') return fail(err); }
  if (exists && !force) die(`${file} already exists; refusing to overwrite it (use --force to replace it)`);
  let gen;
  try {
    if (!exists) {
      gen = keys.generateHubKey({ file });
    } else {
      // --force: write a fresh 0600 file next to it, then rename over the old one (atomic).
      const tmp = path.join(path.dirname(file), `.${path.basename(file)}.${process.pid}.tmp`);
      gen = keys.generateHubKey({ file: tmp });
      try {
        fs.renameSync(tmp, file);
      } catch (err) {
        try { fs.unlinkSync(tmp); } catch { /* best effort */ }
        throw err;
      }
    }
  } catch (err) {
    if (err?.code === 'EEXIST') die(`${file} already exists; refusing to overwrite it (use --force to replace it)`);
    return fail(err);
  }
  process.stdout.write(
    `wrote ${cleanTerm(file)} (mode 0600)\n` +
    `public key: ${keys.publicKeyString(gen.publicKey)}\n` +
    `keyId: ${keys.keyId(gen.publicKey)}\n` +
    'Pin the public key on each builder in fleet.hubKeys (laneboard fleet pubkey [--pem] prints it again).\n'
  );
}

async function fleetPubkey() {
  const keyFile = takeFlag('--key');
  const pem = takeBool('--pem');
  if (argv.length) die(`unexpected argument: ${argv[0]}`, 2);
  const keys = await fleetKeys();
  let priv;
  let file;
  try {
    file = path.resolve(keyFile ?? (await fleetPaths()).hubKeyFile());
    priv = keys.loadPrivateKey(file);
  } catch (err) {
    if (err?.code === 'ENOENT') die(`no hub key at ${file}; create one with: laneboard fleet keygen`);
    return fail(err);
  }
  // stdout carries only the public key (pipe-friendly); the keyId goes to stderr.
  process.stdout.write(pem ? keys.publicKeyPem(priv) : `${keys.publicKeyString(priv)}\n`);
  process.stderr.write(`keyId: ${keys.keyId(priv)}\n`);
}

async function auditFilePath(file) {
  try {
    return path.resolve(file ?? (await fleetPaths()).auditFile());
  } catch (err) { return fail(err); }
}

/** `30s`, `15m`, `1h`, `2d`, `1w` → milliseconds; null when malformed. */
function parseDuration(s) {
  const m = /^(\d{1,9})(s|m|h|d|w)$/.exec(String(s));
  if (!m) return null;
  return Number(m[1]) * { s: 1e3, m: 60e3, h: 3600e3, d: 86400e3, w: 7 * 86400e3 }[m[2]];
}

async function cmdAudit() {
  if (argv[0] === 'verify') {
    argv.shift();
    return auditVerify();
  }
  const n = Number(takeFlag('-n', '50'));
  const since = takeFlag('--since');
  const json = takeBool('--json');
  const file = await auditFilePath(takeFlag('--file'));
  if (argv.length) die(`unexpected argument: ${argv[0]}`, 2);
  if (!Number.isInteger(n) || n < 1) die('-n must be a positive integer', 2);
  let sinceMs = -Infinity;
  if (since !== null) {
    const d = parseDuration(since);
    if (d === null) die('--since takes a duration like 30m, 1h, 2d', 2);
    sinceMs = Date.now() - d;
  }
  let text;
  try {
    text = fs.readFileSync(file, 'utf8');
  } catch (err) {
    if (err?.code === 'ENOENT') die(`no audit log at ${file}`);
    return fail(err);
  }
  const entries = [];
  for (const line of text.split('\n')) {
    if (!line) continue;
    let e;
    try { e = JSON.parse(line); } catch { continue; } // torn line: `audit verify` reports it
    if (!e || typeof e !== 'object' || Array.isArray(e)) continue;
    if (typeof e.ts === 'number' && e.ts < sinceMs) continue;
    entries.push(e);
  }
  const tail = entries.slice(-n);
  if (json) {
    // JSON.stringify escapes every control character, so this is terminal-safe as is.
    for (const e of tail) process.stdout.write(`${JSON.stringify(e)}\n`);
    return;
  }
  const s = (v) => (v === undefined || v === null || v === '' ? '-' : cleanTerm(v));
  const rows = tail.map((e) => [
    typeof e.ts === 'number' ? new Date(e.ts).toISOString().replace('T', ' ').slice(0, 19) : '-',
    s(e.user),
    s(e.via),
    s(e.action),
    s(e.target).slice(0, 60),
    e.result?.ok === true ? `${C.green}ok${C.off}` : `${C.red}${s(e.result?.status ?? 'fail')}${C.off}`,
  ]);
  process.stdout.write(`${table(rows, ['TS', 'USER', 'VIA', 'ACTION', 'TARGET', 'OK'])}\n`);
}

async function auditVerify() {
  const file = await auditFilePath(takeFlag('--file'));
  if (argv.length) die(`unexpected argument: ${argv[0]}`, 2);
  if (!fs.existsSync(file)) die(`no audit log at ${file}`);
  let r;
  try {
    r = (await fleetAudit()).verifyChain(file);
  } catch (err) { return fail(err); }
  for (const w of r.warnings ?? []) {
    process.stderr.write(`warning: ${cleanTerm(w.file)}:${w.line}: ${cleanTerm(w.reason)}\n`);
  }
  if (!r.ok) {
    const b = r.firstBad ?? {};
    die(`audit verify failed: ${b.file ?? file}:${b.line ?? '?'}: ${b.reason ?? 'unknown'} (${r.count} entries verified before it)`);
  }
  process.stdout.write(`ok ${r.count} entries, head ${String(r.head).slice(0, 8)}\n`);
}

// ---------------------------------------------------------------- offline: pause sentinels
// `pause`/`resume`/`paused` write and read the sentinels under the state dir
// directly (server/control/pause.mjs), so pausing works with the server down.
// The state dir is resolved exactly as the server resolves config.stateDir:
// $LANEBOARD_STATE_DIR (a relative value against the cwd), else `stateDir`
// from the config file ($LANEBOARD_CONFIG, else ~/.config/laneboard/config.json;
// must be absolute or start with ~/), else paths.stateDir() ($XDG_STATE_HOME/
// laneboard, else ~/.local/state/laneboard). It is always passed explicitly:
// pause.mjs defaultStateDir() ignores $XDG_STATE_HOME.
//
// `resume` lifts only operator pauses. Budget and quota pauses are remote-only
// (S7): they are lifted from the UI. That is a convention, not a boundary; the
// files are writable by this uid.

const pauseMod = () => import('../server/control/pause.mjs');
const REMOTE_ONLY_HINT = 'budget/quota pauses are lifted from the UI (remote-only)';

/** The config file's own `stateDir` value, or undefined. Mirrors config.mjs loadFile(). */
function configFileStateDir(env) {
  const file = env.LANEBOARD_CONFIG || path.join(os.homedir(), '.config', 'laneboard', 'config.json');
  let text;
  try {
    text = fs.readFileSync(file, 'utf8');
  } catch (err) {
    if (err?.code === 'ENOENT') return { file, layer: {} };
    die(`cannot read the config file ${file}: ${err?.message || err}\n(set LANEBOARD_STATE_DIR to pause without it)`);
  }
  if (!text.trim()) return { file, layer: {} };
  let parsed;
  try { parsed = JSON.parse(text); } catch (err) {
    die(`${file}: not valid JSON — ${err?.message || err}\n(set LANEBOARD_STATE_DIR to pause without it)`);
  }
  if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
    die(`${file}: the config must be a JSON object\n(set LANEBOARD_STATE_DIR to pause without it)`);
  }
  return { file, layer: Object.hasOwn(parsed, 'stateDir') ? { stateDir: parsed.stateDir } : {} };
}

async function resolveStateDir(env = process.env) {
  const control = await import('../server/config/control.mjs');
  const paths = await fleetPaths();
  const envLayer = control.fromEnv(env);
  let fileLayer = {};
  let file = 'LANEBOARD_STATE_DIR';
  if (envLayer.stateDir === undefined) ({ file, layer: fileLayer } = configFileStateDir(env));
  let stateDir;
  try {
    stateDir = envLayer.stateDir ?? fileLayer.stateDir ?? paths.stateDir({ env });
  } catch (err) { return fail(err); }
  const c = control.finalize({ stateDir }, { env: envLayer, file: fileLayer });
  const v = c.stateDir;
  if (typeof v !== 'string' || v === '' || !path.isAbsolute(v) || v.includes('\0')) {
    die(`${file}: stateDir must be an absolute path (or start with ~/), got ${JSON.stringify(v) ?? String(v)}`);
  }
  return v;
}

/** `<name>`, `ALL` or `--all` → a pause scope; exits 2 on anything else. */
async function takeScope(usage) {
  const all = takeBool('--all');
  const reason = takeFlag('--reason');
  const name = argv.shift();
  if (argv.length) die(`unexpected argument: ${cleanTerm(argv[0])}`, 2);
  if (all && name) die(usage, 2);
  const scope = all ? 'ALL' : name;
  if (!scope) die(usage, 2);
  const { isValidScope } = await pauseMod();
  if (!isValidScope(scope)) die(`not a session name: ${JSON.stringify(cleanTerm(scope))}`, 2);
  return { scope, reason };
}

const scopeLabel = (scope) => (scope === 'ALL' ? 'every session (ALL)' : cleanTerm(scope));

async function cmdPause() {
  const { scope, reason } = await takeScope('usage: laneboard pause <name|--all> [--reason "text"]');
  const stateDir = await resolveStateDir();
  const pm = await pauseMod();
  let r;
  try {
    r = pm.pause(scope, { kind: 'operator', by: 'cli', reason }, { stateDir });
  } catch (err) { return fail(err); }
  if (r.kept) {
    process.stdout.write(`${scopeLabel(scope)} is already paused (kind ${r.kind}); kept\n`);
    return;
  }
  process.stdout.write(`paused ${scopeLabel(scope)}  ${C.dim}${cleanTerm(r.file)}${C.off}\n`);
}

async function cmdResume() {
  const { scope } = await takeScope('usage: laneboard resume <name|--all>');
  const stateDir = await resolveStateDir();
  const pm = await pauseMod();
  let r;
  try {
    r = pm.resume(scope, { kinds: ['operator'] }, { stateDir });
  } catch (err) { return fail(err); }
  for (const k of r.kept) {
    process.stderr.write(`laneboard: ${scopeLabel(k.scope)} stays paused (kind ${k.kind}): ${REMOTE_ONLY_HINT}\n`);
  }
  if (r.kept.length) {
    process.exitCode = 1;
    return;
  }
  if (r.removed.length) process.stdout.write(`resumed ${scopeLabel(scope)}\n`);
  else process.stdout.write(`${scopeLabel(scope)} was not paused\n`);
  if (scope !== 'ALL') {
    const all = pm.kindOf('ALL', { stateDir });
    if (all) process.stdout.write(`note: the builder-wide pause (ALL, kind ${all}) still holds every session\n`);
  }
}

async function cmdPaused() {
  const json = takeBool('--json');
  if (argv.length) die(`unexpected argument: ${cleanTerm(argv[0])}`, 2);
  const stateDir = await resolveStateDir();
  const pm = await pauseMod();
  let entries;
  try {
    entries = pm.list({ stateDir });
  } catch (err) { return fail(err); }
  if (json) {
    // JSON.stringify escapes C0 but not DEL or C1 (U+0080..U+009F, incl. the
    // 8-bit CSI/OSC introducers): escape those too, so the output stays valid
    // JSON and terminal-safe.
    const out = JSON.stringify({ stateDir, paused: entries })
      .replace(/[\u007f-\u009f]/g, (ch) => `\\u${ch.charCodeAt(0).toString(16).padStart(4, '0')}`);
    process.stdout.write(`${out}\n`);
    return;
  }
  const s = (v) => (v === undefined || v === null || v === '' ? '-' : cleanTerm(v));
  const rows = entries.map((e) => [
    s(e.scope),
    e.kind === 'operator' ? e.kind : `${C.amber}${e.kind}${C.off}`,
    s(e.by),
    ago(e.at),
    s(e.reason).replace(/\s+/g, ' ').slice(0, 60),
  ]);
  process.stdout.write(`${table(rows, ['SCOPE', 'KIND', 'BY', 'SINCE', 'REASON'])}\n`);
  if (entries.some((e) => e.kind !== 'operator')) process.stdout.write(`${C.dim}${REMOTE_ONLY_HINT}${C.off}\n`);
}

// ---------------------------------------------------------------- offline: run protocol events
// `laneboard run <sub>` writes one run-protocol line (docs/runs.md) so loops do
// not hand-write JSON. The line is built from flags, stamped with `v` and `ts`,
// and checked by parseLine before anything is written; a flag it does not know,
// a missing value or a line parseLine would skip exits 2 and writes nothing.
// It goes to --file, else $LANEBOARD_RUN_FILE, else ./.laneboard/run.jsonl
// (works with the server down), or with --post to POST /api/runs/events.
// --run falls back to the run part of $LANEBOARD_RUN, which `round` exports.

const runProtocol = () => import('../server/runs/protocol.mjs');

// Per subcommand: flag → [event field, kind]. Kinds: str, int, num, bool.
const RUN_COMMON = { '--run': ['run', 'str'], '--file': ['file', 'str'], '--post': ['post', 'bool'] };
const RUN_SUBS = {
  start: {
    '--goal': ['goal', 'str'], '--plan': ['plan', 'str'], '--branch': ['branch', 'str'], '--host': ['host', 'str'],
    '--deadline': ['deadline', 'str'], '--max-rounds': ['maxRounds', 'int'], '--rounds': ['rounds', 'int'],
    '--window-pct': ['windowPct', 'num'],
  },
  round: {
    '--n': ['n', 'int'], '--role': ['role', 'str'], '--task': ['task', 'str'], '--end': ['end', 'bool'],
    '--outcome': ['outcome', 'str'], '--commit': ['commit', 'str'], '--open': ['open', 'int'], '--usd': ['usd', 'num'],
  },
  score: { '--name': ['name', 'str'], '--value': ['value', 'num'], '--better': ['better', 'str'], '--n': ['n', 'int'], '--max': ['max', 'num'] },
  needs: { '--kind': ['kind', 'str'], '--text': ['text', 'str'], '--link': ['link', 'str'], '--n': ['n', 'int'] },
  ack: { '--ref': ['ref', 'str'], '--by': ['by', 'str'] },
  artifact: { '--url': ['url', 'str'], '--kind': ['kind', 'str'], '--title': ['title', 'str'], '--state': ['state', 'str'] },
  stop: { '--reason': ['reason', 'str'], '--rounds': ['rounds', 'int'], '--usd': ['usd', 'num'] },
  cost: { '--usd': ['usd', 'num'], '--n': ['n', 'int'] },
};
const RUN_TYPE = { start: 'run.start', score: 'score', needs: 'needs', ack: 'needs.ack', artifact: 'artifact', stop: 'run.stop', cost: 'cost' };
const ROUND_START_ONLY = ['role', 'task'];
const ROUND_END_ONLY = ['outcome', 'commit', 'open', 'usd'];

const RUN_USAGE = `usage: laneboard run <sub> [--run <id>] [flags] [--file f | --post]
  start    [--goal g] [--plan p] [--branch b] [--host h] [--deadline iso] [--max-rounds N] [--window-pct P]
           --max-rounds N is the round cap; --rounds N on start is its old name (a note on stderr)
  round    --n N [--role r] [--task t]            prints export LANEBOARD_RUN=<run>/<n>, meant for: eval "$(laneboard run round --n N …)"
  round    --n N --end [--outcome o] [--commit sha] [--open N] [--usd x]   --usd is this round only; the run sums them when it has no cost events
  score    --name m --value x [--better higher|lower] [--n N] [--max x]
  needs    ["text" | --text t] [--kind decision|wait|…] [--link url] [--n N]
  ack      [<run>] <ref> [--by b]                 close a need: <ref> is its place (0 = the first) or its ts (no such need: exit 1; already acked: nothing sent, exit 0)
  artifact --url u [--kind pr|link|…] [--title t] [--state open|merged|closed]
  stop     [--reason done|deadline|rounds|budget|no-progress|error|human|…] [--rounds N] [--usd x]
           --rounds N on stop is the count of rounds done, not the cap
  cost     --usd x [--n N]                        what was spent (in round N); the run's cost is the sum of these
every subcommand:
  --run <id>   the run; defaults to the run part of $LANEBOARD_RUN (which \`round\` exports); \`start\` says so on stderr when it uses it
  --file f     append the line to f; defaults to $LANEBOARD_RUN_FILE, else ./.laneboard/run.jsonl
  --post       send the line to POST /api/runs/events on the server instead of a file
  --run, --file and --post may also come before <sub>.`;

// A usage error is one line plus a pointer to the help; no subcommand at all
// prints the whole usage (that is what the user asked for).
const runUsage = (msg) => die(msg ? `run: ${msg}\nsee: laneboard run --help` : RUN_USAGE, 2);

/** `laneboard run <sub> … -h|--help`: a -h/--help word that is not a flag's value. */
function wantsHelp(allowed) {
  for (let i = 0; i < argv.length; i += 1) {
    if (argv[i] === '-h' || argv[i] === '--help') return true;
    const spec = RUN_COMMON[argv[i]] ?? allowed[argv[i]];
    if (spec && spec[1] !== 'bool') i += 1;
  }
  return false;
}

/** One subcommand's lines of RUN_USAGE, then the flags every subcommand takes. */
function subUsage(sub) {
  const lines = RUN_USAGE.split('\n');
  // A subcommand's lines, and the indented note lines right under them.
  const own = lines.flatMap((l, i) => {
    if (l.startsWith(`  ${sub} `)) return [`usage: laneboard run ${l.trim().replace(/^(\S+)\s+/, '$1 ')}`];
    let j = i;
    while (j > 0 && lines[j].startsWith('           ')) j -= 1;
    return j < i && lines[j].startsWith(`  ${sub} `) ? [`  ${l.trim()}`] : [];
  });
  return [...own, ...lines.slice(lines.indexOf('every subcommand:'))].join('\n');
}

/** argv → {field: value} for the allowed flags; every other word is a usage error.
 *  `out` may hold flags already read (the common ones before the subcommand);
 *  with `until`, it stops at the first word that is not a flag in `allowed`. */
function parseRunFlags(allowed, out = {}, until = false) {
  while (argv.length) {
    if (until && !allowed[argv[0]]) break;
    const flag = argv.shift();
    const spec = allowed[flag];
    if (!spec) runUsage(`unexpected argument: ${JSON.stringify(cleanTerm(flag))}`);
    const [field, kind] = spec;
    if (Object.hasOwn(out, field)) runUsage(`${flag} given twice`);
    if (kind === 'bool') { out[field] = true; continue; }
    const raw = argv.shift();
    if (raw === undefined || (raw.startsWith('--') && allowed[raw])) runUsage(`${flag} needs a value`);
    if (kind === 'str') out[field] = raw;
    else {
      const n = /^\s*-?\d+(\.\d+)?\s*$/.test(raw) ? Number(raw) : NaN;
      if (!Number.isFinite(n) || (kind === 'int' && !Number.isInteger(n))) {
        runUsage(`${flag} needs ${kind === 'int' ? 'an integer' : 'a number'}, got ${JSON.stringify(cleanTerm(raw))}`);
      }
      out[field] = n;
    }
  }
  return out;
}

/** The subcommand's flags → one event object (without v/ts), or a usage exit. */
function runEvent(sub, f) {
  if (sub === 'round') {
    if (f.n === undefined) runUsage('round needs --n');
    const wrong = (f.end ? ROUND_START_ONLY : ROUND_END_ONLY).find((k) => f[k] !== undefined);
    if (wrong) runUsage(`--${wrong} belongs to ${f.end ? 'a round start (no --end)' : 'a round end (--end)'}`);
    const { end, ...fields } = f;
    return { t: end ? 'round.end' : 'round.start', ...fields };
  }
  if (sub === 'start') {
    const { rounds, maxRounds, windowPct, ...fields } = f;
    if (rounds !== undefined && maxRounds !== undefined) runUsage('--rounds on start is --max-rounds: give one');
    // `--rounds` on start is the cap's old name; on stop it is the count done.
    if (rounds !== undefined) process.stderr.write('--rounds on start means --max-rounds\n');
    const budget = {};
    if ((maxRounds ?? rounds) !== undefined) budget.maxRounds = maxRounds ?? rounds;
    if (windowPct !== undefined) budget.windowPct = windowPct;
    return { t: 'run.start', ...fields, ...(Object.keys(budget).length ? { budget } : {}) };
  }
  if (sub === 'score') {
    if (f.name === undefined || f.value === undefined) runUsage('score needs --name and --value');
    if (f.better !== undefined && f.better !== 'higher' && f.better !== 'lower') runUsage('--better is higher or lower');
  }
  if (sub === 'artifact' && f.url === undefined) runUsage('artifact needs --url');
  if (sub === 'cost' && f.usd === undefined) runUsage('cost needs --usd');
  if (sub === 'ack') {
    if (f.ref === undefined) runUsage('ack needs a ref (the need\'s place, 0 = the first, or its ts)');
    // A place is written as a number, a time as given (epoch or ISO); parseLine tells them apart.
    return { t: 'needs.ack', ...f, ref: /^\d+$/.test(f.ref) ? Number(f.ref) : f.ref };
  }
  return { t: RUN_TYPE[sub], ...f };
}

async function cmdRun() {
  // --run/--file/--post may come before the subcommand too (`laneboard run --post score …`).
  const first = parseRunFlags(RUN_COMMON, {}, true);
  if (argv[0]?.startsWith('-') && !['-h', '--help'].includes(argv[0])) {
    runUsage(`${JSON.stringify(cleanTerm(argv[0]))} goes after the subcommand (laneboard run <sub> [flags])`);
  }
  const sub = argv.shift();
  if (sub === '-h' || sub === '--help' || sub === 'help') {
    process.stdout.write(`${RUN_USAGE}\n`);
    return;
  }
  if (!Object.hasOwn(RUN_SUBS, sub ?? '')) runUsage(sub ? `unknown run subcommand: ${JSON.stringify(cleanTerm(sub))}` : '');
  if (wantsHelp(RUN_SUBS[sub])) {
    process.stdout.write(`${subUsage(sub)}\n`);
    return;
  }
  // `ack [<run>] <ref>`: up to two words that are not flags or flag values, anywhere
  // after `ack`; one is the ref, two are the run and the ref. A third is an error below.
  const words = [];
  for (let i = 0; sub === 'ack' && i < argv.length && words.length < 2; i += 1) {
    const spec = RUN_COMMON[argv[i]] ?? RUN_SUBS.ack[argv[i]];
    if (spec) { if (spec[1] !== 'bool') i += 1; continue; }
    if (!argv[i].startsWith('--')) { words.push(argv[i]); argv.splice(i, 1); i -= 1; }
  }
  if (words.length === 2) {
    if (Object.hasOwn(first, 'run')) runUsage('--run given twice');
    first.run = words.shift();
  }
  if (words.length) first.ref = words[0];
  // `needs "text"`: the first word that is not a flag or a flag's value is the text;
  // a second one, or --text as well, is left for parseRunFlags to refuse.
  for (let i = 0; sub === 'needs' && i < argv.length; i += 1) {
    const spec = RUN_COMMON[argv[i]] ?? RUN_SUBS.needs[argv[i]];
    if (spec) { if (spec[1] !== 'bool') i += 1; continue; }
    if (argv[i].startsWith('--')) continue;
    first.text = argv.splice(i, 1)[0];
    break;
  }
  const f = parseRunFlags({ ...RUN_COMMON, ...RUN_SUBS[sub] }, first);
  const { run: runFlag, file: fileFlag, post, ...fields } = f;
  if (post && fileFlag !== undefined) runUsage('--file and --post do not go together');
  const inherited = (process.env.LANEBOARD_RUN || '').split('/')[0];
  const run = runFlag ?? inherited;
  if (!run) runUsage('--run <id> is required (or set $LANEBOARD_RUN)');
  // A new run that inherits its id from the shell is usually a leftover export
  // of another run's round: keep it (scripts rely on it), but say where it came from.
  if (sub === 'start' && runFlag === undefined) process.stderr.write(`run id ${cleanTerm(run)} from $LANEBOARD_RUN\n`);
  const { parseLine, parseLines, foldRun, ackTarget, droppedFields, RUN_ID, FENCE_ACK_BY } = await runProtocol();
  if (!RUN_ID.test(run)) runUsage(`not a run id: ${JSON.stringify(cleanTerm(run))} (letters, digits, . _ -; 64 at most)`);
  const ev = runEvent(sub, fields);
  const event = { v: 1, t: ev.t, run, ts: Date.now(), ...ev };
  const line = JSON.stringify(event);
  const checked = parseLine(line);
  if (!checked.ok) runUsage(`the event would be skipped: ${checked.reason}`);

  const file = post ? null : path.resolve(fileFlag || process.env.LANEBOARD_RUN_FILE || path.join('.laneboard', 'run.jsonl'));
  // Read before the append: the ack's own line must not count as a need.
  let warnings = [];
  if (event.t === 'needs.ack') {
    // The server folds every source of a run by time, so its needs decide when it
    // knows the run. Offline (or a run it does not know), a file ack can only see
    // this file's needs: a ref missing there may be another source's, so it warns.
    let needs = await serverNeeds(run, { unknown: post ? [] : null });
    let where = `on ${BASE}`;
    const offline = !post && !needs;
    if (offline) { needs = fileNeeds(file, run, { parseLines, foldRun }); where = `in ${file}`; }
    const r = ackCheck({ ...checked.event, given: event.ref }, needs, { ackTarget, FENCE_ACK_BY, verb: post ? 'posted' : 'written' });
    // A ref that names no need would only be kept raw: a typo, so write nothing and fail.
    if (r.missing && offline) r.warnings = [`no need ${String(event.ref)} in run ${run} in this file (offline: the server may know it from another source); written anyway`];
    else if (r.missing) return die(`no need ${cleanTerm(String(event.ref))} in run ${run} ${where}; nothing ${post ? 'posted' : 'written'}`);
    // A closed need: a second ack would change nothing, so say so and add no line
    // (exit 0: the need is closed, which is what the caller asked for).
    if (r.acked) return void process.stderr.write(`need ${cleanTerm(String(event.ref))} already acked, nothing ${post ? 'posted' : 'written'}\n`);
    warnings = r.warnings;
  }
  let done;
  if (post) {
    // The receipt is what the server accepted: its run and type, and the fields
    // it will not use (an older server sends no `dropped`: the local check says).
    const r = await api('/api/runs/events', { method: 'POST', body: event });
    const dropped = Array.isArray(r.dropped) ? r.dropped : droppedFields(event, checked.event);
    done = `ok ${r.run || run} ${r.t || event.t} posted${dropped.length ? `, dropped: ${dropped.join(', ')}` : ''}`;
  } else {
    try {
      fs.mkdirSync(path.dirname(file), { recursive: true });
      fs.appendFileSync(file, `${line}\n`);
    } catch (err) { return fail(`cannot write ${file}: ${err?.message || err}`); }
    done = `ok ${run} ${event.t} appended to ${file}`;
  }
  // stdout stays for `eval "$(laneboard run round …)"`; the receipt and warnings go to stderr.
  process.stderr.write(`${cleanTerm(done)}\n`);
  for (const w of warnings) process.stderr.write(`warning: ${cleanTerm(w)}\n`);
  if (event.t === 'round.start') process.stdout.write(`export LANEBOARD_RUN=${run}/${event.n}\n`);
}

/** The needs of `run` in the file an ack appends to ([] when there is no file yet). */
function fileNeeds(file, run, { parseLines, foldRun }) {
  let text = '';
  try { text = fs.readFileSync(file, 'utf8'); } catch { /* no file yet: no need either */ }
  return foldRun(parseLines(text).events.filter((e) => e.run === run)).needs;
}

/** The needs of `run` as the server folded them: `unknown` ([] by default) for a
 *  run it does not know, null when the server cannot tell (unreachable, an error,
 *  an older server). */
async function serverNeeds(run, { unknown = [] } = {}) {
  try {
    const res = await fetch(`${BASE}/api/runs/${encodeURIComponent(run)}`, { headers: { 'x-laneboard': '1' }, signal: AbortSignal.timeout(3000) });
    if (res.status === 404) return unknown;
    if (!res.ok) return null;
    const needs = (await res.json())?.run?.needs;
    return Array.isArray(needs) ? needs : null;
  } catch { return null; }
}

/** What an ack will do, before it is written: `{missing: true}` when the ref names
 *  no need of the run, `{acked: true}` when that need is already closed, else warnings (the ack is still written, exit 0) for a `by`
 *  that cannot close a `fence` need (docs/runs.md). `needs` null = unknown, so the
 *  `by` hint is given as a maybe. */
function ackCheck(ack, needs, { ackTarget, FENCE_ACK_BY, verb }) {
  const byOk = FENCE_ACK_BY.includes(ack.by);
  const byHint = `${ack.by ? `--by ${JSON.stringify(ack.by)}` : 'no --by'}: a fence need closes only with --by ${FENCE_ACK_BY.map((b) => JSON.stringify(b)).join(', ')}`;
  if (!needs) return { warnings: byOk ? [] : [`${byHint}, if this need is one (advisory: the ack is ${verb} as it is)`] };
  const need = ackTarget(needs, ack);
  if (!need) return { missing: true, warnings: [] };
  if (need.acked) return { acked: true };
  if (need.kind === 'fence' && !need.acked && !byOk) return { warnings: [`${byHint}; advisory: the ack is ${verb}, need ${need.i} stays open`] };
  return { warnings: [] };
}

// ---------------------------------------------------------------- feed (offline)
//
// `laneboard feed <kind>` runs one feeder (server/feeders/) once, next to the
// source, and puts the feed where the board reads it. Only `--push` talks to a
// server, and to the URL it is given, not to LANEBOARD_URL.

const feedersMod = () => import('../server/feeders/index.mjs');

const FEED_USAGE = `usage: laneboard feed <kind> [--source s] [--every N] [--timeout s] [--stdout | --out <file> | --push <url>]
  tailscale  reads \`tailscale status --json\` on this machine
  proxmox    --url https://<host>:8006 --token-id user@realm!name [--secret-file f] [--ca pem] [--node n]
             the secret comes from --secret-file or $LANEBOARD_PVE_SECRET
  docker     [--socket path]  the Docker socket (default /var/run/docker.sock); one GET, nothing else
  --source s   the feed's name, and its file <feedsDir>/<s>.json on the board; defaults to the kind
  --every N    seconds between runs (the board calls the feed stale after 3 × N)
  --stdout     print the feed (the default; for an ssh forced command on the board)
  --out f      write the feed to f atomically (temp + rename, mode 0600)
  --push url   POST the feed to <url>/api/map/feeds (a board on this machine)`;

const feedUsage = (msg) => die(msg ? `feed: ${msg}\nsee: laneboard feed --help` : FEED_USAGE, 2);

// flag -> [option, kind, the feeder it belongs to (null = every kind)]
const FEED_FLAGS = {
  '--source': ['source', 'str', null], '--every': ['every', 'int', null], '--timeout': ['timeout', 'int', null],
  '--stdout': ['stdout', 'bool', null], '--out': ['out', 'str', null], '--push': ['push', 'str', null],
  '--url': ['url', 'str', 'proxmox'], '--token-id': ['tokenId', 'str', 'proxmox'],
  '--secret-file': ['secretFile', 'str', 'proxmox'], '--ca': ['ca', 'str', 'proxmox'], '--node': ['node', 'str', 'proxmox'],
  '--socket': ['socket', 'str', 'docker'],
};

function parseFeedFlags(kind) {
  const out = {};
  while (argv.length) {
    const flag = argv.shift();
    if (!Object.hasOwn(FEED_FLAGS, flag)) feedUsage(`unexpected argument: ${JSON.stringify(cleanTerm(flag))}`);
    const [field, type, only] = FEED_FLAGS[flag];
    if (only && only !== kind) feedUsage(`${flag} is for ${only} only`);
    if (Object.hasOwn(out, field)) feedUsage(`${flag} given twice`);
    if (type === 'bool') { out[field] = true; continue; }
    const raw = argv.shift();
    if (raw === undefined || raw === '' || Object.hasOwn(FEED_FLAGS, raw)) feedUsage(`${flag} needs a value`);
    if (type === 'int') {
      if (!/^\d{1,6}$/.test(raw) || Number(raw) < 1) feedUsage(`${flag} needs a whole number of seconds, got ${JSON.stringify(cleanTerm(raw))}`);
      out[field] = Number(raw);
    } else out[field] = raw;
  }
  return out;
}

/**
 * Write `text` to `file` so that a reader sees the old file or the new one,
 * never half. The file is 0600: a feed names machines, addresses and services
 * (the board's own feeds dir is 0700 with 0600 files, server/routes/feeds.mjs).
 */
function writeAtomic(file, text) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const tmp = path.join(path.dirname(file), `.${path.basename(file)}.${process.pid}.tmp`);
  try {
    fs.writeFileSync(tmp, text, { mode: 0o600 });
    fs.chmodSync(tmp, 0o600); // a stale temp of the same name kept its old mode
    fs.renameSync(tmp, file);
  } catch (err) {
    try { fs.rmSync(tmp, { force: true }); } catch { /* nothing to clean */ }
    throw err;
  }
}

async function cmdFeed() {
  const kind = argv.shift();
  if (kind === undefined || kind === '-h' || kind === '--help' || kind === 'help') {
    if (kind === undefined) feedUsage('');
    process.stdout.write(`${FEED_USAGE}\n`);
    return;
  }
  const { feeder, feederNames, collect, SOURCE_ID } = await feedersMod();
  const real = feederNames.filter((k) => k !== 'none');
  if (kind === 'none') feedUsage(`none has nothing to read; pick ${real.join(' or ')}`);
  if (!feeder(kind)) feedUsage(`unknown feeder: ${JSON.stringify(cleanTerm(kind))} (one of ${real.join(', ')})`);
  const f = parseFeedFlags(kind);
  const targets = ['stdout', 'out', 'push'].filter((k) => f[k] !== undefined);
  if (targets.length > 1) feedUsage('--stdout, --out and --push do not go together');
  const source = f.source ?? kind;
  if (!SOURCE_ID.test(source)) feedUsage(`not a source name: ${JSON.stringify(cleanTerm(source))} (letters, digits, . _ -; 64 at most)`);
  let pushUrl = null;
  if (f.push !== undefined) {
    try { pushUrl = new URL('/api/map/feeds', f.push); } catch { feedUsage(`--push needs an http(s) URL, got ${JSON.stringify(cleanTerm(f.push))}`); }
    if (!/^https?:$/.test(pushUrl.protocol)) feedUsage(`--push needs an http(s) URL, got ${JSON.stringify(cleanTerm(f.push))}`);
  }
  if (kind === 'proxmox' && (f.url === undefined || f.tokenId === undefined)) feedUsage('proxmox needs --url and --token-id');

  const readOpts = {};
  for (const k of ['url', 'tokenId', 'secretFile', 'ca', 'node', 'socket']) if (f[k] !== undefined) readOpts[k] = f[k];
  if (f.timeout !== undefined) readOpts.timeoutMs = f.timeout * 1000;
  const r = await collect(kind, { source, every: f.every, ...readOpts });
  if (!r.ok) return fail(r.error);
  const text = `${JSON.stringify(r.feed)}\n`;

  if (f.out !== undefined) {
    const file = path.resolve(f.out);
    try { writeAtomic(file, text); } catch (err) { return fail(`cannot write ${file}: ${err?.message || err}`); }
  } else if (pushUrl) {
    let res;
    try {
      res = await fetch(pushUrl, {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-laneboard': '1' },
        body: text,
        signal: AbortSignal.timeout(15000),
      });
    } catch (err) { return fail(`cannot reach ${pushUrl.origin} (${err?.message || err})`); }
    if (!res.ok) {
      let why = '';
      try { why = (await res.json())?.error || ''; } catch { /* not JSON */ }
      return fail(`${pushUrl.origin} refused the feed: HTTP ${res.status}${why ? ` ${why}` : ''}`);
    }
  } else {
    process.stdout.write(text);
  }
}

function usage(out = process.stdout) {
  out.write(`laneboard — control the Claude sessions and lanes on this box

  laneboard ls                          every session, attention first
  laneboard peek <name> [-n 40]         the last N lines of a pane
  laneboard send <name> "text"          type text + Enter
  laneboard keys <name> Enter [C-c]     send tmux key names
  laneboard events [-n 50] [--session s] [--type t]
  laneboard cost [--today]
  laneboard morning [--window tonight|12h|24h|7d]
                                      what needs you, what finished, what it cost
  laneboard credit                      rate-limit windows and cost per lane
  laneboard dirs                        git repos you can spawn into
  laneboard launch <lane> --plan docs/plans/<lane>.md [--repo <repo>]
                 [--branch feat/<lane>] [--model opus] [--permission-mode auto]
                                      worktree + venv + slot + session + kickoff
  laneboard job <job-id>                follow a launch or retire
  laneboard retire <lane> [--force]     slot down + volumes, worktree removed, record kept
  laneboard spawn <name> <dir> ["prompt"] [--model m]
  laneboard restart <name>
  laneboard kill <name>

Offline (no server needed):
  laneboard fleet keygen [--out <file>] [--force]
                                      new hub key (PEM PKCS8 Ed25519, 0600)
  laneboard fleet pubkey [--key <file>] [--pem]
                                      its public key, for builders' fleet.hubKeys
  laneboard audit [-n 50] [--since 1h] [--file f] [--json]
                                      tail the local audit log
  laneboard audit verify [--file f]     check the audit hash chain
  laneboard pause <name|--all> [--reason "text"]
                                      pause one session or all (writes the sentinel)
  laneboard resume <name|--all>         lift an operator pause (budget/quota: from the UI)
  laneboard paused [--json]             list the pauses
  laneboard run start|round|score|needs|ack|artifact|stop|cost [--run <id>] [flags]
                                      append one run-protocol line (laneboard run --help)
  laneboard feed tailscale|proxmox|docker [--source s] [--stdout | --out <file> | --push <url>]
                                      read one source once into a Map feed (laneboard feed --help)

Server: ${BASE}   (override with LANEBOARD_URL)
`);
}

/** The one command within edit distance 2 of `word`, or the one it is a prefix of; else null. */
function closeCommand(word) {
  const w = String(word).toLowerCase();
  const dist = (a, b) => {
    let prev = Array.from({ length: b.length + 1 }, (_, j) => j);
    for (let i = 1; i <= a.length; i += 1) {
      const row = [i];
      for (let j = 1; j <= b.length; j += 1) row[j] = Math.min(prev[j] + 1, row[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
      prev = row;
    }
    return prev[b.length];
  };
  const names = Object.keys(COMMANDS);
  const hits = names.filter((n) => (w.length > 1 && n.startsWith(w)) || dist(w, n) <= Math.min(2, n.length - 1));
  // `ls` and its alias `list` are one command.
  const fns = new Set(hits.map((n) => COMMANDS[n]));
  return fns.size === 1 ? hits[0] : null;
}

const COMMANDS = {
  ls: cmdLs, list: cmdLs, peek: cmdPeek, send: cmdSend, keys: cmdKeys,
  events: cmdEvents, cost: cmdCost, spawn: cmdSpawn, kill: cmdKill,
  restart: cmdRestart, dirs: cmdDirs, morning: cmdMorning, credit: cmdCredit,
  launch: cmdLaunch, job: cmdJob, retire: cmdRetire,
  fleet: cmdFleet, audit: cmdAudit,
  pause: cmdPause, resume: cmdResume, paused: cmdPaused,
  run: cmdRun, feed: cmdFeed,
};

if (!cmd || cmd === '-h' || cmd === '--help' || cmd === 'help') {
  usage();
  process.exit(cmd ? 0 : 2);
}
const fn = COMMANDS[cmd];
if (!fn) {
  // The error first (what a script or a person greps), then a close match, then the
  // help; all on stderr. Exit 2 = a usage error.
  process.stderr.write(`laneboard: unknown command: ${cleanTerm(cmd)}\n`);
  const near = closeCommand(cmd);
  if (near) process.stderr.write(`did you mean: laneboard ${near}\n`);
  process.stderr.write('\n');
  usage(process.stderr);
  process.exit(2);
}
try {
  await fn();
} catch (err) {
  if (err?.unreachable) die(`${err.message}\nIs it running?  laneboardctl status`);
  throw err;
}
