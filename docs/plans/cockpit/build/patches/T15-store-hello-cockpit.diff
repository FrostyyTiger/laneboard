diff --git a/test/store.test.mjs b/test/store.test.mjs
index 90951be..eca74a0 100644
--- a/test/store.test.mjs
+++ b/test/store.test.mjs
@@ -460,3 +460,17 @@ test('SR8 L4: an auto source passes builder-less legacy frames straight through'
