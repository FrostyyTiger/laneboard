+
+test('cockpit D93: hello.cockpit and the fleet frame\'s cockpit are kept as a boolean, only true is true', () => {
+  const s = createStore();
+  assert.equal(s.source.cockpit, null, 'unknown before the first frame');
+  ingest(s, { type: 'hello', builder: { id: 'b1', code: 'B1' }, cockpit: true });
+  assert.equal(s.source.cockpit, true);
+  ingest(s, { type: 'hello', builder: { id: 'b1', code: 'B1' }, cockpit: 'yes' });
+  assert.equal(s.source.cockpit, false);
+  const h = hubStore();
+  ingest(h, { type: 'fleet', builders: [], cockpit: true });
+  assert.equal(h.source.cockpit, true);
+  ingest(h, { type: 'fleet', builders: [] });
+  assert.equal(h.source.cockpit, false);
+});
