+// SKETCH ONLY (wall-sketch5, not for merging): look toggles read from the URL
+// once at module load, so every galaxy module can bend its constants. Every
+// default (param missing or 0) is today's look exactly. In node (the tests)
+// there is no `location`, so everything is 0.
+//
+//   sk_tight=0|1|2  sk_size=0|1  sk_moons=0|1  sk_tint=0|1|2|3
+//   sk_sun=0|1      sk_soft=0|1  sk_haze=0|1
+//   v2: sk_arr=0|1|2 (site arrangement)  sk_sys=0|1|2 (system spacing)  sk_pal=0|1|2|3 (palette)
+// v2: a missing param takes DEFAULTS (the owner's v1 picks), not 0.
+
+/**
+ * The defaults when a param is missing: the owner's picks from v1 (2026-10-27),
+ * the v1 preset in the panel. "Current" (today's look) sets every param to 0.
+ */
+export const DEFAULTS = Object.freeze({ tight: 2, size: 1, moons: 0, tint: 2, sun: 1, soft: 1, haze: 1, arr: 0, sys: 0, pal: 0, card: 1 });
+const MAX = { tight: 2, size: 1, moons: 1, tint: 3, sun: 1, soft: 1, haze: 1, arr: 2, sys: 2, pal: 3, card: 1 };
+
+const read = () => {
+  try {
+    if (typeof globalThis.location?.search !== 'string') throw new Error('no page');
+    const q = new URLSearchParams(globalThis.location.search);
+    const out = {};
+    for (const k of Object.keys(MAX)) {
+      const v = q.get(`sk_${k}`);
+      out[k] = v == null || v === '' ? DEFAULTS[k] : Math.max(0, Math.min(MAX[k], Math.round(Number(v)) || 0));
+    }
+    return out;
+  } catch {
+    // Node (the tests): today's look, every toggle off.
+    return Object.fromEntries(Object.keys(MAX).map((k) => [k, 0]));
+  }
+};
+
+export const SK = Object.freeze(read());
+
+/** Arm spacing per sk_tight: the spiral's r0/step/gaps, the nebulae (a little less, so clouds may touch), the systems' spread. */
+export const TIGHT = Object.freeze([
+  { arm: 1, neb: 1, spread: 1 },
+  { arm: 0.67, neb: 0.78, spread: 0.85 },
+  { arm: 0.5, neb: 0.64, spread: 0.75 },
+][SK.tight]);
+
+/**
+ * sk_size: how much a thing carries to its radius factor, log scale,
+ * clamped 0.8x-2.2x. `per` is the growth per doubling.
+ */
+export const carryScale = (n, per) => (SK.size ? Math.max(0.8, Math.min(2.2, 0.8 + per * Math.log2(1 + Math.max(0, n)))) : 1);
+
+/**
+ * sk_tint: quiet per-site hues (OKLCH hue degrees), far below the status
+ * hues' chroma (p3 0.11, p2 0.16, p1 0.23). Cool: blue / violet / teal / slate.
+ * Warm-ish (amber-free): teal / indigo / plum / sage.
+ */
+export const TINT_SETS = Object.freeze({
+  cool: [[255, 0.05], [295, 0.05], [195, 0.045], [235, 0.025]],
+  warm: [[180, 0.045], [275, 0.05], [335, 0.045], [145, 0.04]],
+});
+export const tintSet = () => (SK.tint === 2 || (SK.pal === 2 && SK.tint === 0) ? TINT_SETS.warm : TINT_SETS.cool);
+/** Whether the sites carry a quiet hue at all (sk_tint, or sk_pal=2 dusk, which is built on it). */
+export const tinted = () => SK.tint > 0 || SK.pal === 2;
+
+/** sk_sys: a system's spread, and the least gap between two planets as a share of its reach. */
+export const SYS = Object.freeze([{ spread: 1, gap: 0 }, { spread: 1.4, gap: 0.13 }, { spread: 1.75, gap: 0.17 }][SK.sys]);
+
+/** sk_pal=3 flat: the muted fills a site's calm planets take (OKLCH hue, chroma): slate, sage, sand, mauve. */
+export const FLAT_SET = Object.freeze([[250, 0.04], [145, 0.04], [62, 0.035], [330, 0.04]]);
+
+/**
+ * sk_pal=1 lift: the calm greys a step lighter (stone, not mid-grey) and the
+ * ground a deep blue-black. Set as the page's tokens before the palette is
+ * read, so the names over the canvas lift with the bodies.
+ */
+export function applyPal(root) {
+  if (SK.pal !== 1 || !root?.style) return;
+  root.style.setProperty('--text-3', 'oklch(76% 0.012 75)');
+  root.style.setProperty('--text-2', 'oklch(87% 0.01 75)');
+  root.style.setProperty('--bg-canvas', 'oklch(14% 0.024 262)');
+  root.dataset.skPal = 'lift';
+}
+
+/** sk_soft: open/fold time and the softer curve (smootherstep: no jerk at either end). */
+export const SOFT = Object.freeze({ openMs: 2800, openAt: 0.32, drift: 0.6, freeEaseMs: 750, dust: 0.6, backMs: 3000, perPx: 0.0032, tauMs: 650, follow: 70, maxVel: 1.4 });
+export const smoother = (x) => {
+  const k = Math.max(0, Math.min(1, x));
+  return k * k * k * (k * (k * 6 - 15) + 10);
+};
