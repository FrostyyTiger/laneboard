diff --git a/public/js/wall/galaxy/card.js b/public/js/wall/galaxy/card.js
new file mode 100644
index 0000000..ad9d26b
--- /dev/null
+++ b/public/js/wall/galaxy/card.js
@@ -0,0 +1,363 @@
+// SKETCH v3 (wall-sketch5, not for merging): the node action card, a clickable
+// mock of ~/stellaris-ui-brief.md §2/§4 ("the dossier"), behind `sk_card=1`.
+// It reads the selection (main.js `__galaxySelection`), stands beside the
+// selected node with a thin leader line (docked to the right edge when there
+// is no room), and reads, top to bottom: header (status dot, name, type chip,
+// parent path), 3-4 key stats, a "Below" strip of child chips, an action row
+// (at most 4 + "…") and the C6 actions as disabled ghosts tagged "later".
+// Navigation actions navigate for real; the rest toast "mock: <action>".
+//
+// `createCard({ stage, canvas, galaxy, screenOf, nav, close })`:
+// `nav.goTo(id)` selects a node and flies to it, `nav.openSite(id)` flies into
+// a site, `close()` drops the selection. Returns `{ show(sel), hide(), frame() }`.
+
+import { hash } from './layout.js';
+import { toneOf } from './palette.js';
+
+const W = 360; // card width, css px
+const GAP = 36; // node edge to card
+const EDGE = 16;
+const IDLE_MS = 60000;
+const HOLD_MS = 1200;
+
+const TONE_VAR = { crit: 'var(--p1)', warn: 'var(--p2)', low: 'var(--p3)', calm: 'var(--text-3)' };
+const KIND_WORD = { site: 'SITE', host: 'HOST', room: 'ROOM', builder: 'BUILDER', service: 'SERVICE', lane: 'LANE', session: 'SESSION', repo: 'REPO', package: 'PACKAGE' };
+
+const el = (tag, cls, text) => {
+  const e = document.createElement(tag);
+  if (cls) e.className = cls;
+  if (text != null) e.textContent = text;
+  return e;
+};
+const pct = (v) => `${Math.round(v * 100)}%`;
+const toneOfValue = (v) => (v >= 0.95 ? 'crit' : v >= 0.85 ? 'warn' : null);
+
+/** A fake grey sparkline ending at `v` (0..1), the same for an id on every load. */
+function spark(id, v, tone) {
+  const n = 12, pts = [];
+  for (let i = 0; i < n; i++) {
+    const w = i === n - 1 ? v : Math.max(0.02, Math.min(1, v + (hash(`${id}~sp${i}`) - 0.5) * 0.35 * (1 - i / n)));
+    pts.push(`${(i / (n - 1)) * 54 + 1},${15 - w * 13}`);
+  }
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('viewBox', '0 0 56 16');
+  svg.setAttribute('class', 'skc-spark');
+  const pl = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
+  pl.setAttribute('points', pts.join(' '));
+  pl.setAttribute('fill', 'none');
+  pl.setAttribute('stroke', tone ? TONE_VAR[tone] : 'currentColor');
+  pl.setAttribute('stroke-width', '1.4');
+  svg.append(pl);
+  return svg;
+}
+
+/** What the card says about the selected node: pure but for the world it reads. */
+export function describe(sel, world) {
+  if (!sel || !world) return null;
+  const site = world.byId.get(sel.site);
+  if (!site) return null;
+  const isSite = sel.id === site.id;
+  const member = isSite ? null : site.members.find((m) => m.id === sel.id);
+  const node = isSite ? site.node : member?.node;
+  if (!node) return null;
+  const kind = isSite ? 'site' : node.kind;
+  const tone = isSite ? toneOf(site.status ?? node.status) : toneOf(node);
+  const byId = new Map(site.members.map((m) => [m.id, m]));
+  // The parent path: site › ... › parent.
+  const path = [site.node.label ?? site.id];
+  if (!isSite) {
+    const chain = [];
+    for (let p = byId.get(node.parent), k = 0; p && k < 20; p = byId.get(p.node.parent), k++) chain.unshift(p.node.label ?? p.id);
+    path.push(...chain);
+  }
+  const children = site.members.filter((m) => (isSite ? m.node.parent === site.id : m.node.parent === node.id));
+  const stats = [];
+  const met = node.metrics ?? {};
+  if (isSite) {
+    const rooms = children.filter((m) => m.planet);
+    const up = rooms.filter((m) => !['down', 'crit', 'error', 'failed'].includes(m.node.status)).length;
+    stats.push({ label: 'rooms up', value: `${up}/${rooms.length}`, off: up < rooms.length ? 'crit' : null });
+  }
+  if (!isSite || tone !== 'calm' || node.why) stats.push({ label: 'status', value: node.why ?? (isSite ? site.status ?? node.status : node.status) ?? tone, off: tone !== 'calm' ? tone : null });
+  for (const k of ['cpu', 'mem', 'disk']) {
+    if (met[k] == null || stats.length >= 4) continue;
+    stats.push({ label: k.toUpperCase(), value: pct(met[k]), off: toneOfValue(met[k]), spark: met[k] });
+  }
+  if (node.counts && stats.length < 4) stats.push({ label: 'lanes', value: `${node.counts.lanes ?? 0} · ${node.counts.working ?? 0} working · ${node.counts.waiting ?? 0} waiting`, off: node.counts.waiting ? 'warn' : null });
+  if (node.m?.costUsd != null && stats.length < 4) stats.push({ label: 'cost', value: `$${node.m.costUsd.toFixed(2)}` });
+  if (node.m?.ctxPct != null && stats.length < 4) stats.push({ label: 'context', value: `${node.m.ctxPct}%`, off: node.m.ctxPct >= 85 ? 'warn' : null });
+  for (const [k, v] of Object.entries(node.detail ?? {})) {
+    if (stats.length >= 4) break;
+    if (k === 'ID') continue;
+    stats.push({ label: k.toLowerCase(), value: String(v) });
+  }
+  if (stats.length < 4 && node.sub) stats.push({ label: 'what', value: node.sub });
+  if (isSite && stats.length < 4) stats.push({ label: 'last backup', value: `${1 + Math.floor(hash(`${site.id}~bk`) * 9)} h ago (mock)` });
+
+  // Actions, ranked (the brief's table); `nav` ones navigate, the rest are mocks.
+  const trouble = tone === 'crit' || tone === 'warn';
+  const hasBelow = children.length > 0;
+  const fly = { key: 'fly', label: 'Fly to', icon: '➚', nav: true };
+  const below = { key: 'below', label: "What's below", icon: '▾', nav: true };
+  const board = { key: 'board', label: 'Board', icon: '⇱' };
+  const pin = { key: 'pin', label: 'Pin', icon: '⊙' };
+  let actions, more = [], later = [];
+  switch (kind) {
+    case 'site':
+      actions = [{ key: 'open', label: 'Open site', icon: '◎', nav: true }, below, board, pin];
+      more = [{ key: 'proxmox', label: 'Proxmox ›' }];
+      break;
+    case 'room':
+    case 'host':
+      actions = [{ key: 'logs', label: 'View logs', icon: '▣' }, board, ...(hasBelow ? [below] : []), pin];
+      more = [fly, { key: 'terminal', label: 'Terminal ›' }, { key: 'proxmox', label: 'Proxmox ›' }];
+      break;
+    case 'builder':
+      actions = [{ key: 'runlog', label: 'Run log', icon: '▣' }, ...(hasBelow ? [below] : []), board, pin];
+      more = [fly];
+      later = [{ key: 'pause-builder', label: 'Pause all', icon: '❚❚' }];
+      break;
+    case 'service':
+      actions = [{ key: 'logs', label: 'View logs', icon: '▣' }, board, pin, fly];
+      later = [{ key: 'restart', label: 'Restart', icon: '↻', hold: true }];
+      break;
+    case 'lane':
+      actions = [{ key: 'log', label: 'View log', icon: '▣' }, { key: 'pr', label: 'Open PR', icon: '⇱' }, pin, fly];
+      later = [{ key: 'pause-lane', label: 'Pause lane', icon: '❚❚' }];
+      break;
+    default:
+      actions = [{ key: 'log', label: 'View log', icon: '▣' }, board, pin, fly];
+  }
+  if (trouble) later.push({ key: 'snooze', label: 'Snooze', icon: '⌛' }, { key: 'ack', label: 'Ack', icon: '✓' });
+  if (actions.length > 4) { more = [...actions.slice(4), ...more]; actions = actions.slice(0, 4); }
+  // Only the top-ranked action is filled: the first, and logs first when the node is red.
+  actions = actions.map((a, i) => ({ ...a, filled: i === 0 }));
+  return {
+    id: sel.id, site: site.id, kind, tone, name: node.label ?? sel.id,
+    chip: [KIND_WORD[kind] ?? String(kind).toUpperCase(), node.detail?.ID != null ? String(node.detail.ID) : null].filter(Boolean).join(' · '),
