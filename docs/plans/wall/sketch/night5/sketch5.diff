+      b.addEventListener('click', () => {});
+    } else {
+      b.addEventListener('click', () => { poke(); say('coming with cockpit C6'); });
+    }
+    return b;
+  };
+
+  const render = () => {
+    root.replaceChildren();
+    if (!info) return;
+    root.dataset.tint = String(info.tint % 4);
+    root.dataset.kind = info.kind;
+    const head = el('div', 'skc-head');
+    const pip = el('span', 'skc-pip');
+    pip.style.background = TONE_VAR[info.tone];
+    const titles = el('div', 'skc-titles');
+    const row = el('div', 'skc-namerow');
+    row.append(pip, el('span', 'skc-name', info.name), el('span', 'skc-chip', info.chip));
+    titles.append(row, el('div', 'skc-path', info.path));
