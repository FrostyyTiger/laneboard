+  for (const ev of ['pointerdown', 'pointerup', 'click', 'wheel', 'contextmenu']) root.addEventListener(ev, (e) => e.stopPropagation());
+
+  let sel = null, info = null, idle = null, toastT = null, expanded = false, menu = false;
+  const say = (text) => {
+    toast.textContent = text;
+    toast.hidden = false;
+    toast.classList.remove('skc-in');
