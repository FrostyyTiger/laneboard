+.skc-toast{position:fixed;left:50%;bottom:28px;translate:-50% 0;z-index:9500;padding:10px 16px;border-radius:8px;font:13px system-ui,sans-serif;color:#e8eaee;
+  background:rgb(20 24 30 / .92);border:1px solid rgb(255 255 255 / .16);pointer-events:none}
+.skc-toast[hidden]{display:none}
+.skc-toast.skc-in{animation:skc-fade .15s ease-out}
