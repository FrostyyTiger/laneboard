+
+  const act = (a) => {
+    poke();
+    if (a.key === 'open') { nav.openSite(info.site); return; }
+    if (a.key === 'fly') { nav.goTo(info.id, { fly: true }); return; }
+    if (a.key === 'below') { expanded = !expanded; render(); return; }
+    if (a.key === 'more') { menu = !menu; render(); return; }
+    say(`mock: ${a.label.replace(' ›', '')}`);
+  };
+
+  const button = (a, cls = '') => {
+    const b = el('button', `skc-btn ${cls} ${a.filled ? 'skc-filled' : ''}`.trim());
+    b.type = 'button';
+    if (a.icon) b.append(el('span', 'skc-ico', a.icon));
+    b.append(el('span', 'skc-lbl', a.label));
+    b.addEventListener('click', () => act(a));
+    return b;
+  };
+  const ghost = (a) => {
+    const b = el('button', 'skc-btn skc-ghost');
+    b.type = 'button';
+    b.setAttribute('aria-disabled', 'true');
