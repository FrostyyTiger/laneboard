+
+export function createCard({ stage, canvas, galaxy, screenOf, nav, close }) {
+  if (!document.querySelector('link[href="/css/sketch5.css"]')) {
+    const css = document.createElement('link');
+    css.rel = 'stylesheet';
+    css.href = '/css/sketch5.css';
+    document.head.append(css);
+  }
+  const root = el('div', 'skc');
