+// SKETCH ONLY (wall-sketch5): the look toggles as a small panel top left.
+// A tap rewrites the URL (keeping every other param) and reloads.
+// `sk_panel=0` hides it (for clean screenshots); the ▸ button folds it.
+
+import { SK } from './sketch.js';
+
+const ROWS = [
+  ['sk_tight', 'Spacing', ['today', '1/3 tighter', 'half']],
+  ['sk_arr', 'Arrangement', ['today', 'staggered', 'rosette'], 'staggered: the two arms half a step apart, all sites level; rosette: a wider spiral, a site every 72°'],
+  ['sk_sys', 'System room', ['today', 'roomier', 'roomiest'], 'planets spread wider, never closer than a set gap'],
+  ['sk_size', 'Size = carries', ['off', 'on']],
+  ['sk_moons', 'Moons', ['off', 'nested'], 'tap a planet: its moons open out round it'],
+  ['sk_tint', 'Tint', ['grey', 'cool', 'warm', 'cool+planets']],
+  ['sk_pal', 'Palette', ['today', 'lift', 'dusk', 'flat'], 'lift: calm things a step lighter, blue-black ground; dusk: stronger, wider site haze; flat: muted matte fills per site'],
+  ['sk_sun', 'Warm sun', ['off', 'on']],
+  ['sk_soft', 'Soft motion', ['off', 'on']],
+  ['sk_haze', 'Depth haze', ['off', 'on']],
+  ['sk_card', 'Action card', ['off', 'on'], 'tap a node: its card (mock actions; navigation is real)'],
+];
+const KEY = Object.fromEntries(ROWS.map(([p]) => [p, p.slice(3)]));
+const ZERO = Object.fromEntries(ROWS.map(([p]) => [p, 0]));
+const PRESETS = [
+  ['Current', ZERO],
+  ['Marcel v1', { ...ZERO, sk_tight: 2, sk_size: 1, sk_tint: 2, sk_sun: 1, sk_soft: 1, sk_haze: 1, sk_card: 1 }],
+  ['v2 pick', { ...ZERO, sk_tight: 2, sk_size: 1, sk_tint: 2, sk_sun: 1, sk_soft: 1, sk_haze: 1, sk_arr: 2, sk_sys: 1, sk_moons: 1, sk_pal: 1, sk_card: 1 }],
+];
+
+const go = (set) => {
+  const q = new URLSearchParams(location.search);
+  // Explicit values: a missing param means the owner's v1 picks (sketch.js DEFAULTS), not today.
+  for (const [k, v] of Object.entries(set)) q.set(k, String(v));
+  location.search = q.toString();
+};
+
+
+function build() {
+  const q = new URLSearchParams(location.search);
+  if (q.get('sk_panel') === '0') return;
+  if (document.querySelector('link[href="/css/sketch5.css"]')) { /* the card brought it */ } else {
+  const style = document.createElement('link');
+  style.rel = 'stylesheet';
+  style.href = '/css/sketch5.css';
+  document.head.append(style);
+  }
+  const el = document.createElement('div');
+  el.className = 'sk-panel';
+  el.dataset.skPanel = '1';
+  let folded = false;
+  try { folded = sessionStorage.getItem('sk-folded') === '1'; } catch { /* none */ }
+  if (folded) el.classList.add('folded');
+  const head = document.createElement('div');
+  head.className = 'sk-head';
+  const title = document.createElement('span');
+  title.className = 'sk-title';
+  title.textContent = 'Galaxy sketch';
+  const fold = document.createElement('button');
+  fold.textContent = folded ? '▸ open' : '▾ fold';
+  fold.addEventListener('click', () => {
+    folded = !folded;
+    el.classList.toggle('folded', folded);
+    fold.textContent = folded ? '▸ open' : '▾ fold';
+    try { sessionStorage.setItem('sk-folded', folded ? '1' : '0'); } catch { /* none */ }
+  });
+  head.append(title, fold);
+  const body = document.createElement('div');
+  body.className = 'sk-body';
+  const presets = document.createElement('div');
+  presets.className = 'sk-presets';
+  for (const [label, set] of PRESETS) {
+    const b = document.createElement('button');
+    b.textContent = label;
+    if (Object.entries(set).every(([k, v]) => SK[KEY[k]] === v)) b.classList.add('on');
+    b.addEventListener('click', () => go(set));
+    presets.append(b);
+  }
+  body.append(presets);
+  for (const [param, label, opts, hint] of ROWS) {
+    const row = document.createElement('div');
+    row.className = 'sk-row';
+    const name = document.createElement('span');
+    name.textContent = label;
+    row.append(name);
+    opts.forEach((o, i) => {
+      const b = document.createElement('button');
+      b.textContent = o;
+      if (SK[KEY[param]] === i) b.classList.add('on');
+      b.addEventListener('click', () => go({ [param]: i }));
+      row.append(b);
+    });
+    body.append(row);
+    if (hint) {
+      const sub = document.createElement('div');
+      sub.className = 'sk-row sk-sub';
+      const t = document.createElement('span');
+      t.textContent = hint;
+      sub.append(t);
+      body.append(sub);
+    }
+  }
+  const note = document.createElement('div');
+  note.className = 'sk-note';
+  note.textContent = 'Moons are real data (a room\'s services, a builder\'s lanes and sessions). '
+    + 'Tap a site to open it, a planet to open its moons; drag to turn an open system. '
+    + 'Back: right-click, double-click/tap on empty sky, or the Back control.';
+  body.append(note);
+  el.append(head, body);
+  // The panel's taps are its own: the galaxy's finger watch never sees them.
+  for (const ev of ['pointerdown', 'pointerup', 'touchstart', 'touchend', 'click', 'wheel']) el.addEventListener(ev, (e) => e.stopPropagation());
+  document.body.append(el);
+}
+
+if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', build);
+else build();
